    {
      "name": "10 - GET /produtos/:id - Verificar que o produto excluído não existe mais",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/{{novoProdutoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "{{novoProdutoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Produto não deve mais existir\", function () {",
              "    const dados = pm.response.json();",
