      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Produto deve ser atualizado corretamente\", function () {",
              "    const produto = pm.response.json();",
              "    pm.expect(produto.descricao).to.eql(\"Monitor LED 24 polegadas\");",
              "    pm.expect(produto.preco).to.eql(849.90);",
              "    pm.expect(produto.estoque).to.eql(12);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - GET /produtos/:id - Verificar se a alteração foi realizada",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/{{novoProdutoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "{{novoProdutoId}}"]
